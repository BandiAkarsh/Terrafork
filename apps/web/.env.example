# TerraFork Web Application Environment Variables
# Copy this file to .env and customize the values below

# Development Mode (automatically set by Vite)
VITE_DEV_MODE=true

# API Configuration
# Base URL for the scraper service API
# In development: http://localhost:8000 (local scraper)
# In production: https://terrafork-scraper.workers.dev
VITE_API_BASE_URL=http://localhost:8000

# Optional: Analytics (disabled by default for privacy)
# VITE_ANALYTICS_ENABLED=false
# VITE_ANALYTICS_ID=

# Optional: Feature Flags
# VITE_ENABLE_DARK_MODE=true
# VITE_ENABLE_OFFLINE_MODE=true
